# DFIP V1 — environment variable template
#
# Copy this file to `.env` for local overrides:
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (macOS/Linux)
#
# Local/demo: `.env` may be used. demo seed exists. dev_token is allowed only
# in development and test.
# Production-grade (staging/production): secrets come from the process or
# container environment. A local `.env` is not read. Never commit `.env`.
#
# Rules:
# - Never put real credentials in this file.
# - Never commit `.env`.
# - P0 does not require production credentials. Empty values are valid.
# - Prefix DFIP_ is used for application settings. Vendor names (SUPABASE_*)
#   follow those products' conventions so they match later deployment docs.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Named environment. Allowed values: development | test | staging | production
# Unknown values refuse to start. staging and production are production-grade.
DFIP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Controls application and uvicorn log level. Production-grade unknown values
# refuse to start. Do not log Authorization, Cookie, passwords, or DATABASE_URL.
DFIP_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Production-grade environments require a non-empty https:// DFIP_WEB_ORIGIN
# and https:// DFIP_API_BASE_URL. Local HTTP is for development/test only.
# -----------------------------------------------------------------------------
DFIP_API_HOST=127.0.0.1
DFIP_API_PORT=8000
DFIP_API_BASE_URL=http://127.0.0.1:8000
DFIP_API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Web application (P6). Browser origin. The SPA calls the P5 API; it is not
# an identity provider and must not receive secrets.
# -----------------------------------------------------------------------------
DFIP_WEB_ORIGIN=http://127.0.0.1:3000
DFIP_WEB_HOST=127.0.0.1
DFIP_WEB_PORT=3000

# In-process upload executor size. Default 1. Capped at 4. Transform work
# remains serialized in the API process. Not a separate worker service.
DFIP_WORKER_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Database / Supabase
# V1 default: leave DATABASE_URL empty (in-memory stores; python -m pytest).
# Persistence path: set DATABASE_URL to PostgreSQL 16 (local) or hosted
# Supabase (Free tier). Production-grade environments require DATABASE_URL.
# Remote production-grade hosts must include sslmode=require (or verify-ca /
# verify-full). sslmode=require encrypts transport but does not authenticate
# the server the way verify-full does. Loopback / compose dfip_db / postgres
# hosts do not require TLS in P13A.
# Never put passwords in git. P1 tests do not require these values.
#
# Hosted Supabase: Project Settings → Database → Connection string (URI).
# Use Direct connection or Session pooler (port 5432) with sslmode=require.
# Do not use Transaction pooler (port 6543) with this psycopg application.
# Shape only — never a real password:
# DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Persistence uses DATABASE_URL only (server-side). SUPABASE_URL / anon /
# service-role keys are reserved for later Auth/PostgREST and must never be
# shipped to the browser, Excel, or Power BI.
# -----------------------------------------------------------------------------
# Postgres connection string used by the application (not the client).
DATABASE_URL=

# Optional: PostgreSQL 16 URL for `pytest -m postgres` only. Not read by the API.
# Never point this at a live acceptance database; the suite drops `public`.
# DFIP_TEST_DATABASE_URL=

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Publishable anon key. Never grant this key table SELECT in DFIP.
SUPABASE_ANON_KEY=

# Service-role key. Server-side only. Never ship to Excel or the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Object storage — private original source files (server-side only).
# Empty DFIP_STORAGE_ENDPOINT uses an in-memory adapter (development/test;
# not durable across restart). Local demo prepare fills an empty value with
# tmp/dfip-source-archive so upload restart recovery has a filesystem. Production-grade
# (staging/production) requires a private local directory. HTTP(S) endpoints are
# not configured.
# Bucket name is the logical prefix.
# Never put these values in Excel, PublishedFacts.m, or frontend JavaScript.
# P13C backup last-success directory (optional). Authenticated readiness may
# report the manifest timestamp only. Do not hash the archive on /health.
# Empty means backup age is not configured. Never a public HTTP root.
# DFIP_BACKUP_LAST_DIR=
# -----------------------------------------------------------------------------
DFIP_STORAGE_BUCKET=dfip-source-files
DFIP_STORAGE_ENDPOINT=

# -----------------------------------------------------------------------------
# Authentication (P5 foundation). Never commit real tokens or secrets.
# -----------------------------------------------------------------------------
# Allowed values: dev_token | jwt
# dev_token is refused when DFIP_ENV=production and is allowed only in
# development or test. An empty DFIP_DEV_AUTH_TOKEN is not a bypass.
DFIP_AUTH_MODE=dev_token
DFIP_DEV_AUTH_TOKEN=

# UI role for the development token only. Default reader (client surface).
# Allowed: reader | client | publisher | admin. Ignored in production (dev_token
# is refused there). This is not RLS.
# After P9, reader/client cannot inspect GET /api/v1/facts or staging routes.
# Use publisher or admin for working-set inspection.
DFIP_DEV_AUTH_ROLE=reader

# Required when DFIP_AUTH_MODE=dev_token and DATABASE_URL is set. Binds the
# development token to one client. The token is never a platform-wide RLS
# administrator. Leave empty for in-memory local tests that pass client_id
# explicitly. Must be a UUID. Do not commit a production client id.
DFIP_DEV_AUTH_CLIENT_ID=

# Production-grade (staging/production):
# - Do not use this file. Set variables in the process/container environment.
# - DFIP_AUTH_MODE=jwt is required.
# - DFIP_AUTH_SECRET must be at least 32 characters and must not be a known
#   example/test value (changeme, secret, or repository fixture secrets).
# - DATABASE_URL is required. Remote hosts must include sslmode=require
#   (or verify-ca / verify-full). sslmode=require encrypts transport but does
#   not authenticate the server the way verify-full does. Colocated V1
#   PostgreSQL uses loopback (see documentation/V1_DEPLOYMENT.md).
# - DFIP_WEB_ORIGIN and DFIP_API_BASE_URL must be non-empty https:// URLs.
# - First publisher setup is denied unless DFIP_BOOTSTRAP_TOKEN is set and the
#   caller sends matching header X-DFIP-Bootstrap-Token. Remove the token
#   after setup. GET /auth/setup-status does not advertise the window.
# Rotation: replace DFIP_AUTH_SECRET and restart — existing HS256 JWTs become
# invalid and users must sign in again. Replace DATABASE_URL and restart.
DFIP_AUTH_SECRET=
DFIP_AUTH_ISSUER=
DFIP_AUTH_AUDIENCE=
# Access JWT lifetime in seconds. Production/default remains 3600 in settings.py.
# Tokens still expire; this is not a non-expiring JWT.
# Local/demo recommended: 43200 (12 hours). Uncomment to override.
# DFIP_AUTH_TOKEN_TTL_SECONDS=43200
#
# Excel Settings BearerToken access JWT lifetime. Keep this short (default 3600).
# Do not set this to months. Post-expiry Refresh All uses DFIP_EXCEL_GRANT_TTL_SECONDS.
# DFIP_EXCEL_ACCESS_TTL_SECONDS=3600
# How long a client/reader workbook may POST /auth/refresh after access exp.
# Default 2592000 (30 days). Revoked on logout. Not a publisher/admin token.
# DFIP_EXCEL_GRANT_TTL_SECONDS=2592000
# Disposable Excel-authored Client Report template for packaging gates only.
# Empty / unset uses tracked excel/Client_Report.xlsx. Do not set this in the
# normal DFIP runtime. Do not point it at the tracked master to overwrite it.
# DFIP_CLIENT_REPORT_TEMPLATE=

# Read GET /publications/history/facts from publication_history_grain.
# Default true. Set false to use the original per-page DISTINCT ON query.
# Publish still rebuilds the serving table either way.
# DFIP_HISTORY_SERVING_TABLE=true

# -----------------------------------------------------------------------------
# D8 Contextual Ask (optional language-model wording)
# -----------------------------------------------------------------------------
# Default none: Ask still answers from D1–D7 calculations using a template.
# Optional wording providers: openai | gemini. Neither classifies intents nor
# calculates analytics. DFIP remains the source of truth. Provider failures
# fall back to deterministic template wording (llm_used=false).
# The key stays on the API server. The browser never receives it.
# The model does not execute SQL.
# Production enablement of a network provider also requires per-principal
# rate limiting, a completion budget, and spend controls (M4). Do not set a
# provider in this template. Never commit a real API key.
#
# Free Gemini tier is for development / low-risk testing until the project's
# privacy/data policy approves sending real client data.
# When DFIP_ASK_PROVIDER=gemini, set DFIP_ASK_MODEL to a Gemini API model id
# (not a Cursor IDE model name) and DFIP_ASK_API_BASE to the native
# generateContent host. Leave the OpenAI defaults when provider=openai.
# DFIP_ASK_PROVIDER=none
# DFIP_ASK_API_KEY=
# DFIP_ASK_API_BASE=https://api.openai.com/v1
# DFIP_ASK_MODEL=gpt-4o-mini
# Gemini example (placeholders only; keep provider=none unless explicitly testing):
# DFIP_ASK_API_BASE=https://generativelanguage.googleapis.com/v1beta
# DFIP_ASK_MODEL=
# DFIP_ASK_TIMEOUT_SECONDS=20
# DFIP_ASK_MAX_OUTPUT_TOKENS=4096
# DFIP_ASK_MAX_QUESTION_CHARS=500

# Production-grade first-publisher bootstrap. Empty means setup is denied.
# Callers must send the same value in header X-DFIP-Bootstrap-Token.
# Never put this token in a query string. Remove it after the first publisher
# exists. Development/test setup does not require this header.
# DFIP_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# Local demo identity seed (never a migration; refuses hosted/production).
# START_DFIP_DEMO.bat runs this path via scripts/dfip_demo_prepare.py.
# Manual: python -m dfip_api.local_demo_seed --confirm-local-only
# Leave these empty unless you are seeding a disposable local database.
# Never commit real passwords.
# -----------------------------------------------------------------------------
# DFIP_LOCAL_DEMO_SEED=
# DFIP_LOCAL_DEMO_PUBLISHER_PASSWORD=
# DFIP_LOCAL_DEMO_CLIENT_PASSWORD=
# Optional second tenant (python -m dfip_api.local_demo_seed --confirm-local-only --company-2)
# DFIP_LOCAL_DEMO_PUBLISHER2_PASSWORD=
# DFIP_LOCAL_DEMO_CLIENT2_PASSWORD=

# -----------------------------------------------------------------------------
# HTTP workbook ingest / published download (V2)
# -----------------------------------------------------------------------------
# Max multipart .xlsx size in bytes.
# P13E / production default remains 10485760 (10 MiB) in settings.py and
# deploy/env/production.env.example. Raise production only with operator approval.
# Local/demo recommended: 52428800 (50 MiB). Uncomment to override.
# DFIP_UPLOAD_MAX_BYTES=52428800
# Max workbook parts in one multipart request. Default 5.
# DFIP_UPLOAD_MAX_FILES=5
# Max total multipart bytes. P13E / production default remains 20971520 (20 MiB).
# Local/demo recommended: 104857600 (100 MiB) so one 50 MiB workbook is not rejected.
# 0 means 2 × DFIP_UPLOAD_MAX_BYTES.
# DFIP_UPLOAD_MAX_TOTAL_BYTES=104857600
# Max non-multipart JSON/body bytes. Default 262144 (256 KiB). Multipart uploads skip this.
# DFIP_JSON_MAX_BODY_BYTES=262144
# Max rows for published CSV/XLSX and Client Report download. Default 75000
# so an August-scale published slice (~50286) is not refused.
# DFIP_DOWNLOAD_MAX_ROWS=75000
# Maximum non-empty source facts per workbook. Default 750000 so 200K is not
# rejected and the 500K target can be measured. 0 disables the cap.
# DFIP_UPLOAD_MAX_FACTS=750000
# Safety cutoff for one upload job in seconds. 0 disables. Not the 10-minute SLA.
# DFIP_UPLOAD_MAX_PROCESSING_SECONDS=0

# -----------------------------------------------------------------------------
# P13F company lifecycle / backup identify (no automatic purge)
# -----------------------------------------------------------------------------
# Days after deactivation before purge eligibility. Unset = not clock-eligible.
# 0 = immediately eligible. Never auto-purges. Host backup timer is P13G (`deploy/`).
# DFIP_COMPANY_PURGE_MIN_AGE_DAYS=
# Keep-count for `python -m dfip_api.backup identify-eligible`. Never deletes.
# DFIP_BACKUP_KEEP_COUNT=1
# Optional age filter in days for identify-eligible. 0 disables.
# DFIP_BACKUP_KEEP_DAYS=0
# Age in hours for leftover dfip-upload-* temp dirs (identify/delete helper).
# DFIP_TEMP_UPLOAD_MAX_AGE_HOURS=24
