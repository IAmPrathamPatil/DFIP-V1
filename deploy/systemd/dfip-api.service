# REPOSITORY-DEFINED: module entrypoint, loopback bind, environment variable names.
# HOST-DEFINED: User, Group, paths, PostgreSQL unit name.
#
# Install (example):
#   /etc/systemd/system/dfip-api.service
#   systemctl daemon-reload && systemctl enable --now dfip-api

[Unit]
Description=DFIP API (single instance)
Documentation=file:///opt/dfip/current/documentation/V1_DEPLOYMENT.md
After=network-online.target
Wants=network-online.target
# HOST-DEFINED: add After=postgresql.service if the local PostgreSQL unit uses that name.

[Service]
Type=simple
User=dfip
Group=dfip
WorkingDirectory=/opt/dfip/current
EnvironmentFile=/etc/dfip/dfip.env
ExecStart=/opt/dfip/current/.venv/bin/python -m dfip_api
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dfip-api
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
