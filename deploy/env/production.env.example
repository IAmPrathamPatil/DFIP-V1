# DFIP V1 production environment template.
# Copy to /etc/dfip/dfip.env on the host. chmod 0640. owner root:dfip.
# Never commit a filled copy. Never put secrets in systemd unit files.
# Production-grade process environments do not read a repository-local .env.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
DFIP_ENV=production
DFIP_LOG_LEVEL=INFO
DFIP_AUTH_MODE=jwt

# Loopback only. Caddy is the public HTTPS edge.
DFIP_API_HOST=127.0.0.1
DFIP_API_PORT=8000
DFIP_WEB_HOST=127.0.0.1
DFIP_WEB_PORT=3000
DFIP_API_PREFIX=/api/v1
DFIP_WORKER_CONCURRENCY=1

# Public HTTPS origins. Replace dfip.example.com with the operator domain.
# These are browser-facing URLs, not the loopback bind addresses.
DFIP_WEB_ORIGIN=https://dfip.example.com
DFIP_API_BASE_URL=https://dfip.example.com

# -----------------------------------------------------------------------------
# Secrets (operator-supplied; leave empty in git)
# DFIP_AUTH_SECRET must be at least 32 characters and must not be a known-bad value.
# -----------------------------------------------------------------------------
DFIP_AUTH_SECRET=
DFIP_AUTH_ISSUER=
DFIP_AUTH_AUDIENCE=
DFIP_AUTH_TOKEN_TTL_SECONDS=3600

# First-publisher bootstrap. Set only for the private first-boot window.
# Remove after POST /api/v1/auth/setup-publisher succeeds. Never a query parameter.
DFIP_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# Database — colocated PostgreSQL 16 on loopback.
# Use a LOGIN role that can SET LOCAL ROLE dfip_api and is NOT BYPASSRLS.
# Do not put the backup/purge superuser DSN in this file.
# Loopback hosts do not require sslmode (P13A). Do not use hosted markers.
# Shape only — never a real password:
# DATABASE_URL=postgresql://dfip_login:YOUR_PASSWORD@127.0.0.1:5432/dfip
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Source archive — persistent volume mount. Not the git tree.
# -----------------------------------------------------------------------------
DFIP_STORAGE_ENDPOINT=/var/lib/dfip/source-storage
DFIP_STORAGE_BUCKET=dfip-source-files

# Optional: last successful backup directory for authenticated readiness age only.
# Never a public HTTP root.
DFIP_BACKUP_LAST_DIR=/var/lib/dfip/backups/last

# -----------------------------------------------------------------------------
# P13E limits (defaults shown). 64 MiB per file / 128 MiB total fits FY-2026 Raw.
# -----------------------------------------------------------------------------
DFIP_UPLOAD_MAX_BYTES=67108864
DFIP_UPLOAD_MAX_FILES=5
DFIP_UPLOAD_MAX_TOTAL_BYTES=134217728
DFIP_JSON_MAX_BODY_BYTES=262144
DFIP_DOWNLOAD_MAX_ROWS=75000

# -----------------------------------------------------------------------------
# P13F lifecycle (no automatic purge)
# Days after deactivation before purge eligibility. Unset = not clock-eligible.
# -----------------------------------------------------------------------------
# DFIP_COMPANY_PURGE_MIN_AGE_DAYS=
DFIP_BACKUP_KEEP_COUNT=3
DFIP_BACKUP_KEEP_DAYS=14
DFIP_TEMP_UPLOAD_MAX_AGE_HOURS=24
