# Privileged operator overlay for backup/purge only.
# Copy to /etc/dfip/dfip-operator.env. chmod 0600. owner root:root.
# systemd dfip-api.service must NOT load this file.
#
# DATABASE_URL here must be a superuser or BYPASSRLS-capable LOGIN.
# Never dfip_api. Never grant BYPASSRLS to dfip_api.
# Shape only — never a real password:
# DATABASE_URL=postgresql://dfip_operator:YOUR_PASSWORD@127.0.0.1:5432/dfip

DATABASE_URL=
